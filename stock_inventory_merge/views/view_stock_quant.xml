<odoo>

    <record id="view_stock_quant_tree" model="ir.ui.view">
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable" />        
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_stock_moves']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_view_orderpoints']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_view_duplicates_quants_tree" model="ir.actions.act_window">
        <field name="name">Duplicates Quants</field>
        <field name="res_model">stock.quant</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_stock_quant_tree"/>
    </record>

</odoo>
